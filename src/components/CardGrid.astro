---
import type { Card } from '../data/types';
import { resolveHref } from '../lib/urls';
import Media from './Media.astro';

interface Props {
  cards: Card[];
  className?: string;
}

const { cards, className = '' } = Astro.props;
---
<div class:list={['card-grid', className]}>
  {cards.map((card, index) => (
    <article
      class:list={[
        'content-card',
        {
          'product-card':
            card.image &&
            ['travel-trailer', 'fifth-wheel', 'lightweight', 'toy-hauler', 'class-a', 'class-b', 'class-c'].includes(
              card.image,
            ),
          'logo-card': card.image?.startsWith('logo-'),
        },
      ]}
      data-story-card={card.tags ? '' : undefined}
      data-story-tags={card.tags?.length ? card.tags.join('|') : undefined}
      data-story-index={card.tags ? String(index) : undefined}
    >
      <a class="card-link" href={resolveHref(card.href)}>
        {card.image && (
          <div class="card-image">
            <Media
              id={card.image}
              alt={card.imageAlt || card.title}
              sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
            />
          </div>
        )}
        <div class="card-copy">
          {card.eyebrow && <p class="eyebrow">{card.eyebrow}</p>}
          <h3>{card.title}</h3>
          {card.text && <p>{card.text}</p>}
          <span class="text-link">
            {card.action || 'Learn More'}
            <span aria-hidden="true">↗</span>
          </span>
        </div>
      </a>
    </article>
  ))}
</div>
