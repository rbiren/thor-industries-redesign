---
import Media from './Media.astro';
import { footerGroups, footerLinks, socialLinks } from '../data/navigation';
import { isExternalHref, navItemHref, routeHref } from '../lib/urls';
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a class="brand-link" href={routeHref('')} aria-label="THOR Industries home">
        <Media id="thor-logo" alt="THOR Industries" sizes="150px" />
      </a>
      <p class="footer-tagline">Go Everywhere. Stay Anywhere.</p>
      <ul class="social-list" aria-label="THOR social channels">
        {socialLinks.map((link) => (
          <li>
            <a href={link.href}>
              <span>{link.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="footer-grid" role="navigation" aria-label="Footer navigation">
      {footerGroups.map((group) => (
        <div class="footer-column">
          <h2>{group.label}</h2>
          <ul>
            {group.items?.map((item) => {
              const href = navItemHref(item);
              const external = isExternalHref(href);
              return (
                <li>
                  <a href={href}>
                    <span>{item.label}</span>
                    {external && <span aria-hidden="true">↗</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>

    <div class="footer-bar">
      <p>©2026 THOR Industries, Inc. All Rights Reserved.</p>
      <ul class="footer-legal" aria-label="Legal and contact links">
        {footerLinks.map((link) => (
          <li>
            <a href={link.href}>
              <span>{link.label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
