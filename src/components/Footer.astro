---
import { navigation } from '../data/navigation';
import { siteUrl } from '../lib/urls';
import Media from './Media.astro';
---
<footer class="site-footer">
  <div class="footer-top"><a class="footer-brand" href={siteUrl('/')} aria-label="THOR Industries home"><Media id="thor-logo" alt="THOR Industries" sizes="160px" /></a><p>Go Everywhere.<br />Stay Anywhere.</p></div>
  <nav class="footer-nav" aria-label="Footer navigation">
    {navigation.filter(item => item.links).map(group => (
      <div><h2>{group.title}</h2>{group.links!.map(link => <a href={siteUrl(link.href)}>{link.title}</a>)}</div>
    ))}
    <div><h2>Explore</h2><a href={siteUrl('/thor-companies/')}>THOR Companies</a><a href="https://ir.thorindustries.com/ir-home/default.aspx">Investors ↗</a><a href="https://www.thorindustries.com/contact-us/">Contact THOR ↗</a><a href="https://www.thorindustries.com/terms-and-conditions/">THOR Terms ↗</a><a href="https://www.thorindustries.com/privacy-policy/">THOR Privacy ↗</a></div>
  </nav>
  <div class="footer-bottom">
    <p>Independent redesign. Not the official THOR Industries website. THOR copy, photographs and trademarks are used with the site owner’s confirmed permission. Source content captured October 2026; dated reports and news retain their original dates.</p>
    <details><summary>About this site & privacy</summary><p>This static redesign is published by the owner of the rbiren/thor-industries-redesign repository on GitHub Pages. It has no sign-up forms, analytics, advertising cookies, or lead collection. Search runs locally in your browser. GitHub may process standard hosting request data under its own privacy terms. Links marked ↗ and tool, article, company, application and report links take you to their original publishers; those sites apply their own terms and privacy practices.</p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement">GitHub Privacy Statement ↗</a></details>
  </div>
</footer>
