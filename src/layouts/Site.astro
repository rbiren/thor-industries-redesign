---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { siteUrl } from '../lib/urls';
interface Props { title: string; description: string; image?: string; noindex?: boolean }
const { title, description, image = 'hero', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={siteUrl('favicon.png')} type="image/png" />
    <title>{title} | THOR Industries — Independent Redesign</title>
    <meta property="og:title" content={`${title} | THOR Industries — Independent Redesign`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(siteUrl(`media/${image}-960.webp`), Astro.site).href} />
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
