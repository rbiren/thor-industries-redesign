---
import Site from '../layouts/Site.astro';
import { routeHref } from '../lib/urls';
---
<Site
  title="Page not found | THOR Industries"
  description="Find your way back to THOR’s RV guides, companies, and stories."
  noindex
>
  <section class="not-found section-inner">
    <p class="eyebrow">404</p>
    <h1>Page not found.</h1>
    <p>We couldn’t find that page. Explore RVs, discover a story, or return to the THOR Industries homepage.</p>
    <div class="action-row">
      <a class="button dark" href={routeHref('')}>Back to Home</a>
      <a class="text-link" href={routeHref('stories')}>
        <span>Explore Stories</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Site>
