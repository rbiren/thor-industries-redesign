---
import Site from '../layouts/Site.astro';
import Media from '../components/Media.astro';
import CardGrid from '../components/CardGrid.astro';
import { builtPages } from '../data/pages';
import { categories } from '../data/stories.mjs';
import { companies, companyGroups, homeBrands } from '../data/companies.mjs';
import media from '../data/media.json';
import { resolveHref, routeHref, siteUrl } from '../lib/urls';
import { sourceHandoffs } from '../data/routes';
import type { Page } from '../data/types';

export function getStaticPaths() {
  return builtPages.map((page) => ({
    params: { slug: page.slug || undefined },
    props: { page },
  }));
}

interface Props {
  page: Page;
}

const { page } = Astro.props;
const currentPath = page.slug ? `/${page.slug}/` : '/';
const isHome = page.kind === 'home';
const desktopHero = media.hero;
const mobileHero = media['hero-mobile'];
const desktopHeroSrc = siteUrl(`media/hero-${desktopHero.widths.at(-1)}.webp`);
const desktopHeroSet = desktopHero.widths.map((w) => `${siteUrl(`media/hero-${w}.webp`)} ${w}w`).join(', ');
const mobileHeroSet = mobileHero.widths.map((w) => `${siteUrl(`media/hero-mobile-${w}.webp`)} ${w}w`).join(', ');

const desktopFinder = media['finder-cta'];
const mobileFinder = media['finder-cta-mobile'];
const desktopFinderSrc = siteUrl(`media/finder-cta-${desktopFinder.widths.at(-1)}.webp`);
const desktopFinderSet = desktopFinder.widths.map((w) => `${siteUrl(`media/finder-cta-${w}.webp`)} ${w}w`).join(', ');
const mobileFinderSet = mobileFinder.widths.map((w) => `${siteUrl(`media/finder-cta-mobile-${w}.webp`)} ${w}w`).join(', ');
---
<Site
  title={isHome ? 'THOR Industries | Go Everywhere. Stay Anywhere.' : `${page.title} | THOR Industries`}
  description={page.description}
  currentPath={currentPath}
>
  <section class:list={['page-hero', { 'home-hero': isHome }]}>
    <div class="hero-media">
      {isHome ? (
        <picture>
          <source media="(max-width: 720px)" srcset={mobileHeroSet} sizes="100vw" type="image/webp" />
          <source srcset={desktopHeroSet} sizes="100vw" type="image/webp" />
          <img
            src={desktopHeroSrc}
            width={desktopHero.width}
            height={desktopHero.height}
            alt={page.heroAlt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      ) : (
        <Media id={page.hero} alt={page.heroAlt} loading="eager" fetchpriority="high" />
      )}
    </div>
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-content">
      <p class="eyebrow">{page.label}</p>
      <h1>{page.title}</h1>
      <p class="hero-description">{page.description}</p>
      {isHome && (
        <div class="hero-actions">
          <a class="button" href={sourceHandoffs.rvFinder}>Find Your RV</a>
          <a class="button ghost" href={routeHref('thor-companies')}>Explore Companies</a>
        </div>
      )}
      {isHome && (
        <dl class="hero-stats" aria-label="THOR Industries highlights">
          <div>
            <dt>Founded</dt>
            <dd>1980</dd>
          </div>
          <div>
            <dt>Global Operating Brands</dt>
            <dd>40+</dd>
          </div>
          <div>
            <dt>Core RV Categories</dt>
            <dd>6</dd>
          </div>
        </dl>
      )}
    </div>
  </section>

  {page.lead && (
    <section class="lead-band">
      <div class="section-inner narrow">
        {page.lead.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
  )}

  {(page.kind === 'stories' || page.kind === 'category') && (
    <nav class="category-bar" aria-label="Story categories">
      <div class="section-inner category-links">
        <a class:list={[{ active: page.slug === 'stories' }]} href={routeHref('stories')}>
          All Stories
        </a>
        {categories.map((cat) => {
          const slug = `stories/category/${cat.slug}` as const;
          return (
            <a class:list={[{ active: page.slug === slug }]} href={routeHref(slug)}>
              {cat.title}
            </a>
          );
        })}
      </div>
    </nav>
  )}

  {isHome && (
    <>
      <section class="content-section split-feature" id="who-is-thor">
        <div class="section-inner split-grid">
          <div class="split-copy">
            <p class="eyebrow">Global Family of Companies</p>
            <h2>{page.sections[0].title}</h2>
            {page.sections[0].text?.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            <div class="action-row">
              <a class="button dark" href={resolveHref(page.sections[0].href!)}>
                {page.sections[0].action}
              </a>
            </div>
          </div>
          <div class="split-media">
            <div class="video-feature-card">
              <div class="video-poster-wrap">
                <Media
                  id="family"
                  alt="2025 THOR Industries Board Video preview showing a couple outside their Airstream travel trailer."
                  sizes="(max-width: 900px) 100vw, 52vw"
                />
                <button
                  class="video-trigger"
                  type="button"
                  data-video-open={sourceHandoffs.youtubeBoardVideoId}
                  data-video-embed={`${sourceHandoffs.youtubeBoardVideoEmbed}?autoplay=1&rel=0`}
                  aria-expanded="false"
                  aria-controls="video-dialog"
                >
                  <span class="play-badge" aria-hidden="true">▶</span>
                  <span class="video-trigger-copy">
                    <strong>Play 2025 THOR Industries Board Video</strong>
                    <span>Open embedded video player (YouTube · {sourceHandoffs.youtubeBoardVideoId})</span>
                  </span>
                </button>
              </div>
              <div class="video-meta-bar">
                <span>2025 THOR Industries Board Video</span>
                <a class="video-link" href={sourceHandoffs.youtubeBoardVideo}>
                  <span>Watch on YouTube</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </div>

        <dialog class="video-dialog" id="video-dialog" aria-label="2025 THOR Industries Board Video">
          <div class="dialog-shell">
            <div class="dialog-bar">
              <div>
                <p class="eyebrow">Board Video</p>
                <h2>2025 THOR Industries Board Video</h2>
              </div>
              <button class="icon-button" type="button" data-video-close aria-label="Close video player">
                Close
              </button>
            </div>
            <div class="video-frame-wrap" data-video-container></div>
            <p class="video-fallback">
              Prefer viewing directly on YouTube?{' '}
              <a href={sourceHandoffs.youtubeBoardVideo}>
                Open 2025 THOR Industries Board Video on YouTube <span aria-hidden="true">↗</span>
              </a>
            </p>
          </div>
        </dialog>
      </section>

      <section class="content-section tinted" id="family-of-companies">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">North American &amp; Global Brands</p>
              <h2>{page.sections[1].title}</h2>
              {page.sections[1].text?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <a class="button dark" href={resolveHref(page.sections[1].href!)}>
              {page.sections[1].action}
            </a>
          </div>
          <div class="home-brand-grid" aria-label="Featured THOR companies">
            {homeBrands.map((brand) => (
              <article class="brand-card">
                <a class="brand-card-link" href={brand.href}>
                  <div class="brand-card-photo">
                    <Media
                      id={brand.image}
                      alt={brand.imageAlt}
                      sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 25vw"
                    />
                  </div>
                  <div class="brand-card-body">
                    <div class="brand-card-logo">
                      <Media id={brand.logoId} alt={brand.logoAlt} sizes="160px" />
                    </div>
                    <div class="brand-card-footer">
                      <h3>{brand.name}</h3>
                      <span class="text-link">
                        Explore Brand<span aria-hidden="true">↗</span>
                      </span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="content-section" id="explore-rv-types">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">Towable &amp; Motorized</p>
              <h2>{page.sections[2].title}</h2>
              {page.sections[2].text?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <a class="button dark" href={resolveHref(page.sections[2].href!)}>
              {page.sections[2].action}
            </a>
          </div>
          <CardGrid cards={page.sections[2].cards!} className="rv-types-grid" />
        </div>
      </section>

      <section class="content-section tinted" id="rv-buying-season">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">Seasonal Buying Guides</p>
              <h2>{page.sections[3].title}</h2>
            </div>
          </div>
          <CardGrid cards={page.sections[3].cards!} className="buying-season-grid" />
        </div>
      </section>

      <section class="content-section" id="featured-stories">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">Life on the Road</p>
              <h2>{page.sections[4].title}</h2>
            </div>
            <a class="button dark" href={resolveHref(page.sections[4].href!)}>
              {page.sections[4].action}
            </a>
          </div>
          <CardGrid cards={page.sections[4].cards!} />
        </div>
      </section>

      <section class="content-section tinted" id="news-and-events">
        <div class="section-inner">
          <div class="section-header">
            <div>
              <p class="eyebrow">{page.sections[5].subtitle || "What's New and Upcoming"}</p>
              <h2>{page.sections[5].title}</h2>
            </div>
            <a class="button dark" href={resolveHref(page.sections[5].href!)}>
              {page.sections[5].action}
            </a>
          </div>
          <CardGrid cards={page.sections[5].cards!} />
        </div>
      </section>

      <section class="finder-panel" id="find-your-perfect-rv">
        <picture>
          <source media="(max-width: 720px)" srcset={mobileFinderSet} sizes="100vw" type="image/webp" />
          <source srcset={desktopFinderSet} sizes="100vw" type="image/webp" />
          <img
            src={desktopFinderSrc}
            width={desktopFinder.width}
            height={desktopFinder.height}
            alt="A family walking away from a Jayco Jay Flight travel trailer camping in the mountains."
            loading="eager"
            decoding="async"
          />
        </picture>
        <div class="finder-scrim" aria-hidden="true"></div>
        <div class="section-inner finder-copy">
          <p class="eyebrow">RV Finder</p>
          <h2>{page.sections[6].title}</h2>
          {page.sections[6].text?.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <a class="button" href={resolveHref(page.sections[6].href!)}>
            {page.sections[6].action}
          </a>
        </div>
      </section>
    </>
  )}

  {page.kind === 'companies' && (
    <div class="section-inner">
      <nav class="company-nav" aria-label="Company categories">
        {companyGroups.map((group) => {
          const groupTitle = String(group);
          return <a href={`#${groupTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{groupTitle}</a>;
        })}
      </nav>
      {companyGroups.map((group) => {
        const groupTitle = String(group);
        return (
          <section class="company-section" id={groupTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>
            <div class="section-header">
              <div>
                <p class="eyebrow">THOR Family</p>
                <h2>{groupTitle}</h2>
              </div>
            </div>
            <div class="company-grid">
              {companies
                .filter((company) => company.group === groupTitle)
                .map((company) => (
                  <a class="company-tile" href={resolveHref(company.href)}>
                    {company.logo ? (
                      <div class="company-logo">
                        <Media id={`logo-${company.id}`} alt={company.name} sizes="180px" />
                      </div>
                    ) : (
                      <strong>{company.name}</strong>
                    )}
                    <span>
                      {company.name}
                      <em aria-hidden="true">↗</em>
                    </span>
                  </a>
                ))}
            </div>
          </section>
        );
      })}
    </div>
  )}

  {page.kind === 'faq' && (
    <section class="content-section">
      <div class="section-inner narrow faq-list">
        {page.sections.map((section, index) => (
          <details class="faq-item" open={index === 0}>
            <summary>{section.title}</summary>
            <div class="faq-answer">
              {section.text?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>
  )}

  {!isHome && page.kind !== 'companies' && page.kind !== 'faq' && (
    <div class:list={[{ 'timeline-sections': page.slug === 'history' }]}>
      {page.sections.map((section, index) => (
        <section
          class:list={[
            'content-section',
            { tinted: index % 2 === 1, 'split-feature': Boolean(section.image && !section.cards) },
          ]}
        >
          <div class:list={['section-inner', { 'split-grid': Boolean(section.image && !section.cards) }]}>
            <div class="section-copy">
              <h2>{section.title}</h2>
              {section.text?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.bullets && (
                <ul class="feature-list">
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {section.href && !section.cards && (
                <div class="action-row">
                  <a class="button dark" href={resolveHref(section.href)}>
                    {section.action || 'Learn More'}
                  </a>
                </div>
              )}
            </div>
            {section.image && !section.cards && (
              <div class="split-media">
                <Media id={section.image} alt={section.title} sizes="(max-width: 900px) 100vw, 48vw" />
              </div>
            )}
            {section.cards && <CardGrid cards={section.cards} />}
            {section.href && section.cards && (
              <div class="section-footer">
                <a class="button dark" href={resolveHref(section.href)}>
                  {section.action || 'View All'}
                </a>
              </div>
            )}
          </div>
        </section>
      ))}
    </div>
  )}
</Site>
